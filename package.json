{
  "name": "@local/dsh-rvc-cover",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a song into a cover in a target timbre with a local RVC model, and keep speaking and singing on the same voice.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rvc",
    "rvc-cover",
    "cover",
    "singing",
    "voice-conversion",
    "svc",
    "tts",
    "powershell"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SB-TDM/dsh-rvc-cover.git"
  },
  "homepage": "https://github.com/SB-TDM/dsh-rvc-cover#readme",
  "bugs": {
    "url": "https://github.com/SB-TDM/dsh-rvc-cover/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
